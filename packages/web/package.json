{
  "name": "@sis/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:build": "VITE_API_BASE=https://sis.mier.info vite build && cp build/200.html build/index.html && pnpm exec cap sync android",
    "mobile:apk": "pnpm mobile:build && cd android && ./gradlew assembleDebug -q && echo APK: android/app/build/outputs/apk/debug/app-debug.apk",
    "mobile:aab": "pnpm mobile:build && cd android && ./gradlew bundleRelease -q && echo AAB: android/app/build/outputs/bundle/release/app-release.aab"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
    "@platform/ui": "workspace:*",
    "@sis/shared": "workspace:*",
    "d3-hierarchy": "^3.1.2",
    "echarts": "^5.6.0",
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@platform/config": "workspace:*",
    "@platform/mobile": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@vite-pwa/sveltekit": "^1.1.0",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "workbox-window": "^7.4.1"
  }
}
