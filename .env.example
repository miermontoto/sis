SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# en producción tiene que ser https: spotify sólo acepta http para loopback, y
# la app de las stores sólo se conecta a instancias https
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3000
DATABASE_PATH=./data/sis.db

# push notifications (opcionales): sin estas vars el pipeline detecta eventos
# pero el sender hace no-op. FIREBASE_SERVICE_ACCOUNT habilita android/FCM;
# las tres VAPID_* habilitan web push (ver docs/PUSH_NOTIFICATIONS_SETUP.md).
FIREBASE_SERVICE_ACCOUNT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# last.fm (opcional): habilita el login con last.fm y el sync de scrobbles.
# se pide en https://www.last.fm/api/account/create; el redirect por defecto es
# <origen de SPOTIFY_REDIRECT_URI>/auth/lastfm/callback
LASTFM_API_KEY=
LASTFM_API_SECRET=
# LASTFM_REDIRECT_URI=

# nivel de log: debug|info|warn|error|silent (default info)
# LOG_LEVEL=info

# setlist.fm (opcional): sin esta var el registro de conciertos sigue
# funcionando en modo manual y la búsqueda de setlists informa como no
# configurada. Se pide gratis en https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=
